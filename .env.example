# Copy this file to .env and set values locally. Do not commit .env.
#
# --- LLM API keys -----------------------------------------------------------
# DeepSeek (primary provider for the novel agent; tools_call_deepseek.py reads
# DEEPSEEK_API_KEY_1 first, then falls back to DEEPSEEK_API_KEY).
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_1=
# Legacy Gemini keys (used only by the legacy root scripts, not novel_agent).
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# --- Agent runtime ----------------------------------------------------------
# Stage timeout in seconds (novel_agent/service.py; default 30).
# A legacy_real run makes several sequential LLM calls that routinely exceed
# 30s — set this to 7200 when using the real provider, otherwise runs get
# interrupted mid-stage.
NOVEL_AGENT_STAGE_TIMEOUT_SECONDS=7200

# Default provider mode when a request does not specify one
# (novel_agent/default_stage.py). Values: offline_fake | legacy_real
NOVEL_AGENT_PROVIDER_MODE=legacy_real
