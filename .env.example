# Copy this file to .env and set values locally. Do not commit .env.
#
# --- LLM access (OpenAI-compatible endpoint) ----------------------------------
# Volcano Ark Coding Plan:  LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# DeepSeek official:        leave LLM_BASE_URL empty (defaults to DeepSeek).
LLM_BASE_URL=
# API key (ark keys look like ark-xxxxxx). Read first by tools_call_deepseek.
LLM_API_KEY=
# Primary model name / id for the configured endpoint.
LLM_MODEL=
# Optional fallback model id (used when the primary model call fails).
LLM_FALLBACK_MODEL=

# --- Legacy key slots (fallbacks when LLM_API_KEY is unset) ------------------
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_1=
# Legacy Gemini keys (root scripts only, not novel_agent).
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# --- Agent runtime ------------------------------------------------------------
# Stage timeout in seconds (novel_agent/service.py; default 30).
# legacy_real / agent_loop make several sequential LLM calls that routinely
# exceed 30s — set this to 7200 when using a real provider.
NOVEL_AGENT_STAGE_TIMEOUT_SECONDS=7200

# Default provider when a request does not specify one.
# Values: offline_fake | legacy_real | agent_loop
NOVEL_AGENT_PROVIDER_MODE=legacy_real
